diff --git a/kernel/log.c b/kernel/log.c
index dd194f3..58bde83 100644
--- a/kernel/log.c
+++ b/kernel/log.c
@@ -193,3 +193,31 @@ int current_pid() {
         return current->pid;
     return -1;
 }
+
+/* ISH_LOG=strace,debug,memory,... enables release-build trace channels. */
+int ish_log_enabled(const char *chan) {
+    static const char *set = NULL;
+    static int init = 0;
+    if (!init) {
+        set = getenv("ISH_LOG");
+        init = 1;
+    }
+    if (set == NULL)
+        return 0;
+    const char *p = set;
+    while (*p != '\0') {
+        while (*p == ',' || *p == ' ')
+            p++;
+        const char *start = p;
+        while (*p != '\0' && *p != ',' && *p != ' ')
+            p++;
+        size_t n = (size_t)(p - start);
+        if (n == 5 && strncmp(start, "all", 5) == 0)
+            return 1;
+        /* Callers pass the channel name in __func__-independent form; match the
+         * prefix up to the final NOP marker by comparing the whole token. */
+        if (strlen(chan) >= n && strncmp(chan, start, n) == 0)
+            return 1;
+    }
+    return 0;
+}
